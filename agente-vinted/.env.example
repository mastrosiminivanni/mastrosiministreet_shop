# Copia questo file in ".env" (nella stessa cartella) e riempi i valori. Il file ".env" non va mai su Git.
# Chiave Anthropic (console.anthropic.com -> API keys): serve a confrontare le foto per riconoscere lo stesso articolo.
ANTHROPIC_API_KEY=
# Chiave "service_role" di Supabase (Project Settings -> API). Dà pieni poteri sull'archivio: tienila solo qui.
SUPABASE_SERVICE_ROLE_KEY=
